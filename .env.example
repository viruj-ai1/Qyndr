# ============================================================
#  Qyndr DoE Studio – Environment Configuration Example
# ============================================================

# Database configuration (defaults to SQLite in backend/doe_workflow.db)
DATABASE_URL=sqlite:///./doe_workflow.db

# Authentication & JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production
JWT_ALGORITHM=HS256
TOKEN_EXPIRY_HOURS=8

# Optional first-run admin bootstrap (if set, auto-creates initial admin on startup if no users exist)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional Groq LLM API Key (for QbD assistant chat & reporting)
GROQ_API_KEY=

